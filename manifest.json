{
  "manifest_version": 2,
  "name": "GitLab Network Catcher",
  "version": "1.1",
  "description": "Catches GitLab merge request network calls and displays their output.",
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "storage",
    "tabs",
    "https://gitlabcloud.dialog.lk/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
